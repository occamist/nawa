---
type Props = {
    label: string;
    id: string;
    variant: "running" | "stopped" | "total" | "images";
};
const { label, id, variant } = Astro.props;
---

<!-- Single stat tile used in the dashboard grid. Value is populated at runtime via id. -->
<div class="stat-card card">
    <span class="stat-card__label">{label}</span>
    <span class={`stat-card__value stat-card__value--${variant}`} id={id}
        >—</span
    >
</div>

<style lang="scss">
    .stat-card {
        padding: var(--space-5);
        display: flex;
        flex-direction: column;
        gap: var(--space-2);

        &__label {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.1px;
            text-transform: uppercase;
            color: var(--color-text-helper);
            font-family: var(--font-brand);
        }

        &__value {
            font-family: var(--font-brand);
            font-size: 42px;
            font-weight: 700;
            line-height: 1;
            color: var(--color-text);

            &--running {
                color: #14c6cb;
            }
            &--stopped {
                color: #e8922a;
            }
            &--total {
                color: #2b89ff;
            }
            &--images {
                color: #a737ff;
            }
        }
    }
</style>
